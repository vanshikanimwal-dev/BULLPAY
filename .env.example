# Copy to .env. Leave a secret blank to create it once under data/.secrets.

# localhost or production. npm run dev forces localhost. npm start forces production.
BULLPAY_MODE=localhost
NODE_ENV=development

# Required for npm start. A real hostname such as pay.example.com. Never localhost.
PUBLIC_HOSTNAME=

# 64 hex characters when set. Created automatically when empty.
ENCRYPTION_MASTER_KEY=
WEBHOOK_SECRET=
ADMIN_API_TOKEN=
OBSERVER_API_TOKEN=
INTERNAL_SERVICE_TOKEN=

# Optional listen override set by the supervisor for each process.
PORT=

DATA_DIR=data
DATABASE_PATH=

PAYMENT_API_PORT=6100
CHECKOUT_PORT=7000
DEMO_STORE_PORT=5000
ADMIN_PORT=6001
SMS_OBSERVER_PORT=6002
GMAIL_OBSERVER_PORT=6003
HELP_PORT=3000
SUPERVISOR_PORT=8090

PAYMENT_API_ORIGIN=http://127.0.0.1:6100
CHECKOUT_ORIGIN=http://127.0.0.1:7000
DEMO_STORE_ORIGIN=http://127.0.0.1:5000
ADMIN_ORIGIN=http://127.0.0.1:6001
SMS_OBSERVER_ORIGIN=http://127.0.0.1:6002
GMAIL_OBSERVER_ORIGIN=http://127.0.0.1:6003
HELP_ORIGIN=http://127.0.0.1:3000
SUPERVISOR_ORIGIN=http://127.0.0.1:8090

# Checkout iframe allow-list. In localhost mode the demo store origin is used when this is empty.
CHECKOUT_FRAME_ANCESTORS=

PAYMENT_ACTIVE_WINDOW_MS=300000
PAYMENT_PROCESSING_WINDOW_MS=30000

# Prints OTP codes to the API process stdout in development only. Ignored in production.
BULLPAY_DEV_OTP_LOG=false

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_POLL_INTERVAL_MS=5000

# A real Google Messages browser session stays off unless this is true.
ENABLE_BROWSER_OBSERVER=false

# Copied onto the demo merchant only on first boot.
SUPPORT_EMAIL=
SUPPORT_PHONE=
