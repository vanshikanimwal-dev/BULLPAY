{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "packages/**/*.js",
    "apps/**/*.js",
    "scripts/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "data"]
}
